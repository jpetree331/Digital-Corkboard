{
  "name": "digital-corkboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A private infinite notes board backed by Neon Postgres on Vercel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4174",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.0.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "22.x"
  }
}
